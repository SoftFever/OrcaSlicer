+// Orca: ordinary dialogs must be selectable in the macOS window switchers.
+// Keep transient controls and tool windows as panels, with their existing behaviour.
+static bool IsManagedDialog(const wxNonOwnedWindow* window)
+{
+    const long style = window->GetWindowStyle();
+    const long extraStyle = window->GetExtraStyle();
+    return (extraStyle & wxTOPLEVEL_EX_DIALOG) && (style & wxCAPTION) &&
+           !(style & (wxPOPUP_WINDOW | wxFRAME_TOOL_WINDOW)) &&
+           !(extraStyle & wxWS_EX_TRANSIENT);
+}
