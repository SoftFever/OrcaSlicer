-            GetWXPeer()->GetExtraStyle() & wxTOPLEVEL_EX_DIALOG )
+            ((GetWXPeer()->GetExtraStyle() & wxTOPLEVEL_EX_DIALOG) &&
+             !IsManagedDialog(GetWXPeer())) )
         m_macWindow = [wxNSPanel alloc];
     else
         m_macWindow = [wxNSWindow alloc];
@@ -852,6 +864,19 @@ long style, long extraStyle, const wxString& WXUNUSED(name) )
         defer:NO
         ];
 
