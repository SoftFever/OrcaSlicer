#version 430

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct BvhNode
{
    vec4 bounds_min;
    vec4 bounds_max;
};

struct Triangle
{
    vec4 a; // xyz: vertex a, w: tag_z
    vec4 b; // xyz: vertex b, w: floatBits(raw_v_id)
    vec4 c; // xyz: vertex c, w: opacity (alpha)
};

struct Shading
{
    vec4 albedo;
    vec4 params; // x: layer_height, y: role, z: flags, w: reserved
};

struct Ray
{
    vec3 origin;
    vec3 direction;
};

struct Hit
{
    float distance;
    vec3 position;
    vec3 normal;
    float tag;
    float opacity;
    uint tri_index;
    float seg_t;
};

struct Instance
{
    mat4 world_to_local;
    mat4 normal_to_world;
    vec4 bounds_min;
    vec4 bounds_max;
    uvec4 data;
};

layout(std430, binding = 0) readonly buffer NodeBuffer { BvhNode nodes[]; };
layout(std430, binding = 1) readonly buffer TriangleBuffer { Triangle triangles[]; };
layout(std430, binding = 2) readonly buffer InstanceBuffer { Instance instances[]; };
layout(std430, binding = 3) readonly buffer ShadingBuffer { Shading shadings[]; };
uniform int instance_count;
layout(rgba32f, binding = 0) uniform image2D accumulation_image;
layout(rgba8, binding = 1) writeonly uniform image2D display_image;

uniform ivec2 image_size;
uniform vec3 camera_position;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform vec3 camera_forward;
uniform float camera_half_fov;
uniform float camera_orthographic_height;
uniform bool camera_orthographic;
uniform int sample_start;
uniform int sample_count;
uniform int max_bounces;
uniform float z_min;
uniform float z_max;
uniform int move_min;
uniform int move_max;
uniform vec4 clipping_plane;
uniform vec3 light_direction_uniform;
uniform vec3 fill_direction_uniform;
uniform bool shadows_enabled;
uniform int layer_profile_mode;
uniform int sss_mode;
uniform bool is_preview_canvas;

const float PI = 3.14159265358979323846;
const float ray_epsilon = 0.0001;

bool g_has_clipping = false;
bool g_has_move_filter = false;
bool g_has_z_filter = false;

uint random_uint(inout uint state)
{
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return state;
}

float random_float(inout uint state)
{
    return float(random_uint(state) >> 8) * (1.0 / 16777216.0);
}

float safe_ray_dir(float d)
{
    return abs(d) < 1e-8 ? (d < 0.0 ? -1e-8 : 1e-8) : d;
}

vec3 safe_ray_dir3(vec3 d)
{
    return vec3(safe_ray_dir(d.x), safe_ray_dir(d.y), safe_ray_dir(d.z));
}

// Returns the entry distance into the node bounds, or -1.0 if the ray misses them within max_distance.
float bounds_entry_box(vec3 bmin, vec3 bmax, vec3 origin, vec3 inv_dir, float max_distance)
{
    vec3 t0 = (bmin - origin) * inv_dir;
    vec3 t1 = (bmax - origin) * inv_dir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    float near_distance = max(max(tmin.x, tmin.y), max(tmin.z, ray_epsilon));
    float far_distance = min(min(tmax.x, tmax.y), min(tmax.z, max_distance));
    return far_distance >= near_distance ? near_distance : -1.0;
}

// Returns the entry distance into the node bounds, or -1.0 if the ray misses them within max_distance.
float bounds_entry(BvhNode node, vec3 origin, vec3 dir, vec3 inv_dir, float max_distance)
{
    bool is_print_geometry = node.bounds_min.z >= -0.01;
    if (g_has_z_filter && ((is_print_geometry && node.bounds_max.z < z_min) || node.bounds_min.z > z_max))
        return -1.0;

    vec3 t0 = (node.bounds_min.xyz - origin) * inv_dir;
    vec3 t1 = (node.bounds_max.xyz - origin) * inv_dir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    float near_distance = max(max(tmin.x, tmin.y), max(tmin.z, ray_epsilon));
    float far_distance = min(min(tmax.x, tmax.y), min(tmax.z, max_distance));

    if (far_distance < near_distance)
        return -1.0;

    if (g_has_clipping && is_print_geometry) {
        vec3 p_max = vec3(
            clipping_plane.x >= 0.0 ? node.bounds_max.x : node.bounds_min.x,
            clipping_plane.y >= 0.0 ? node.bounds_max.y : node.bounds_min.y,
            clipping_plane.z >= 0.0 ? node.bounds_max.z : node.bounds_min.z
        );
        if (dot(p_max, clipping_plane.xyz) + clipping_plane.w < 0.0)
            return -1.0;

        float denom = dot(dir, clipping_plane.xyz);
        float dist = dot(origin, clipping_plane.xyz) + clipping_plane.w;
        if (denom > 1e-5) {
            near_distance = max(near_distance, -dist / denom);
        } else if (denom < -1e-5) {
            far_distance = min(far_distance, -dist / denom);
        } else if (dist < 0.0) {
            return -1.0;
        }
        if (far_distance < near_distance)
            return -1.0;
    }

    return near_distance;
}

bool intersect_triangle_local(Triangle triangle, Ray local_ray, Ray world_ray, Instance inst, float loc_scale, inout Hit hit, uint tri_idx, bool any_hit)
{
    if (triangle.a.w >= 0.0) {
        if (g_has_z_filter && (triangle.a.w < z_min || triangle.a.w > z_max))
            return false;
        if (g_has_move_filter) {
            uint raw_v_id = floatBitsToUint(triangle.b.w);
            if (raw_v_id != 0xFFFFFFFFu && ((move_min >= 0 && int(raw_v_id) < move_min) || (move_max >= 0 && int(raw_v_id) > move_max)))
                return false;
        }
    }

    if (g_has_clipping && triangle.a.w > -1.5) {
        float da = dot(triangle.a.xyz, clipping_plane.xyz) + clipping_plane.w;
        float db = dot(triangle.b.xyz, clipping_plane.xyz) + clipping_plane.w;
        float dc = dot(triangle.c.xyz, clipping_plane.xyz) + clipping_plane.w;
        if (da < 0.0 && db < 0.0 && dc < 0.0)
            return false;
    }

    vec3 edge1 = triangle.b.xyz - triangle.a.xyz;
    vec3 edge2 = triangle.c.xyz - triangle.a.xyz;
    vec3 cross_value = cross(local_ray.direction, edge2);
    float determinant = dot(edge1, cross_value);
    if (abs(determinant) < 1e-10)
        return false;

    const float edge_epsilon = 2e-4;
    float inverse_determinant = 1.0 / determinant;
    vec3 from_a = local_ray.origin - triangle.a.xyz;
    float u = dot(from_a, cross_value) * inverse_determinant;
    if (u < -edge_epsilon || u > 1.0 + edge_epsilon)
        return false;
    vec3 q = cross(from_a, edge1);
    float v = dot(local_ray.direction, q) * inverse_determinant;
    if (v < -edge_epsilon || u + v > 1.0 + edge_epsilon)
        return false;
    float local_distance = dot(edge2, q) * inverse_determinant;
    if (local_distance < ray_epsilon)
        return false;

    float max_local_dist = hit.distance * loc_scale;
    if (local_distance >= max_local_dist)
        return false;

    float world_distance = local_distance / loc_scale;
    if (world_distance < ray_epsilon || world_distance >= hit.distance)
        return false;

    vec3 hit_pos = world_ray.origin + world_distance * world_ray.direction;
    if (g_has_clipping && triangle.a.w > -1.5 && (dot(hit_pos, clipping_plane.xyz) + clipping_plane.w < 0.0))
        return false;

    float opacity = clamp(shadings[tri_idx].albedo.w, 0.0, 1.0);
    if (opacity < 0.005)
        return false;

    // Shadow rays only need occlusion confirmation and opacity — skip expensive normal reconstruction entirely
    if (any_hit) {
        if (opacity < 0.05)
            return false;
        hit.distance = world_distance;
        hit.position = hit_pos;
        hit.tag = triangle.a.w;
        hit.opacity = opacity;
        hit.tri_index = tri_idx;
        return true;
    }

    vec3 edge3 = triangle.c.xyz - triangle.b.xyz;
    float len1 = dot(edge1, edge1);
    float len2 = dot(edge2, edge2);
    float len3 = dot(edge3, edge3);
    vec3 raw_normal;
    if (len1 >= len2 && len1 >= len3)
        raw_normal = cross(edge3, -edge2);
    else if (len2 >= len1 && len2 >= len3)
        raw_normal = cross(edge1, edge3);
    else
        raw_normal = cross(edge1, edge2);

    float normal_len = length(raw_normal);
    if (normal_len <= 0.0)
        return false;

    vec3 world_normal_unnorm = (inst.normal_to_world * vec4(raw_normal / normal_len, 0.0)).xyz;
    float wn_len = length(world_normal_unnorm);
    if (wn_len <= 0.0)
        return false;
    vec3 world_normal = world_normal_unnorm / wn_len;
    if (dot(world_normal, world_ray.direction) > 0.0)
        world_normal = -world_normal;

    hit.distance = world_distance;
    hit.position = hit_pos;
    hit.normal = world_normal;
    hit.tag = triangle.a.w;
    hit.opacity = opacity;
    hit.tri_index = tri_idx;
    hit.seg_t = ((tri_idx & 1u) == 0u) ? clamp(u + v, 0.0, 1.0) : clamp(u, 0.0, 1.0);
    return true;
}

bool traverse_blas(Instance inst, Ray local_ray, Ray world_ray, vec3 local_inv_dir, float loc_scale, inout Hit hit, bool any_hit)
{
    uint root = inst.data.x;
    if (root >= nodes.length())
        return false;

    float max_local_dist = hit.distance * loc_scale;
    if (bounds_entry(nodes[root], local_ray.origin, local_ray.direction, local_inv_dir, max_local_dist) < 0.0)
        return false;

    bool found = false;
    uint stack[24];
    int stack_size = 0;
    uint node_idx = root;

    while (true) {
        BvhNode node = nodes[node_idx];
        uint count_and_axis = floatBitsToUint(node.bounds_max.w);
        uint count = count_and_axis & 0x3FFFFFFFu;

        if (count > 0u) {
            uint first = uint(floatBitsToInt(node.bounds_min.w));
            for (uint i = first; i < first + count; ++i) {
                if (intersect_triangle_local(triangles[i], local_ray, world_ray, inst, loc_scale, hit, i, any_hit)) {
                    found = true;
                    if (any_hit && triangles[i].c.w >= 0.90)
                        return true;
                }
            }
            if (stack_size == 0)
                break;
            node_idx = stack[--stack_size];
        } else {
            uint split_axis = count_and_axis >> 30;
            uint left_child = uint(floatBitsToInt(node.bounds_min.w));
            uint right_child = left_child + 1u;

            bool is_neg = local_ray.direction[split_axis] < 0.0;
            uint near_child = is_neg ? right_child : left_child;
            uint far_child  = is_neg ? left_child : right_child;

            max_local_dist = hit.distance * loc_scale;
            float d_near = bounds_entry(nodes[near_child], local_ray.origin, local_ray.direction, local_inv_dir, max_local_dist);
            float d_far  = bounds_entry(nodes[far_child],  local_ray.origin, local_ray.direction, local_inv_dir, max_local_dist);

            if (d_near >= 0.0 && d_far >= 0.0) {
                if (stack_size < 24)
                    stack[stack_size++] = far_child;
                node_idx = near_child;
            } else if (d_near >= 0.0) {
                node_idx = near_child;
            } else if (d_far >= 0.0) {
                node_idx = far_child;
            } else {
                if (stack_size == 0)
                    break;
                node_idx = stack[--stack_size];
            }
        }
    }
    return found;
}

// Top-level BVH traversal across instances
bool traverse_scene(Ray ray, inout Hit hit, bool any_hit)
{
    if (instance_count <= 0)
        return false;

    vec3 inv_dir = 1.0 / safe_ray_dir3(ray.direction);

    bool found = false;
    for (int inst_idx = 0; inst_idx < instance_count; ++inst_idx) {
        vec3 bmin = instances[inst_idx].bounds_min.xyz;
        vec3 bmax = instances[inst_idx].bounds_max.xyz;
        if (bounds_entry_box(bmin, bmax, ray.origin, inv_dir, hit.distance) < 0.0)
            continue;

        Instance inst = instances[inst_idx];

        vec3 loc_origin = (inst.world_to_local * vec4(ray.origin, 1.0)).xyz;
        vec3 loc_dir_unnorm = (inst.world_to_local * vec4(ray.direction, 0.0)).xyz;
        float loc_len = length(loc_dir_unnorm);
        if (loc_len < 1e-8)
            continue;
        vec3 loc_dir = loc_dir_unnorm / loc_len;
        vec3 loc_inv_dir = 1.0 / safe_ray_dir3(loc_dir);

        Ray local_ray;
        local_ray.origin = loc_origin;
        local_ray.direction = loc_dir;

        if (traverse_blas(inst, local_ray, ray, loc_inv_dir, loc_len, hit, any_hit)) {
            found = true;
            if (any_hit)
                return true;
        }
    }
    return found;
}

bool intersect_scene(Ray ray, inout Hit hit) { return traverse_scene(ray, hit, false); }

vec3 sky(vec3 direction)
{
    float up = clamp(direction.z, -1.0, 1.0);
    vec3 ground_amb = vec3(0.10, 0.11, 0.13);
    vec3 horizon    = vec3(0.34, 0.37, 0.42);
    vec3 zenith     = vec3(0.52, 0.58, 0.68);
    if (up < 0.0)
        return mix(horizon, ground_amb, clamp(-up * 1.8, 0.0, 1.0));
    return mix(horizon, zenith, pow(up, 0.7));
}

vec3 cosine_hemisphere(vec3 normal, inout uint state)
{
    const float pi = 3.14159265358979323846;
    float angle = 2.0 * pi * random_float(state);
    float radius = sqrt(random_float(state));
    float x = radius * cos(angle);
    float y = radius * sin(angle);
    float z = sqrt(max(0.0, 1.0 - x * x - y * y));
    vec3 helper = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * x + bitangent * y + normal * z);
}

vec4 trace_path(Ray ray, inout uint state)
{
    vec3 base_light_dir = length(light_direction_uniform) > 0.1 ? light_direction_uniform : normalize(vec3(-0.45, -0.48, 0.75));
    vec3 light_jitter = vec3(random_float(state) - 0.5, random_float(state) - 0.5, random_float(state) - 0.5);
    vec3 light_direction = normalize(base_light_dir + light_jitter * 0.08);
    vec3 fill_direction = length(fill_direction_uniform) > 0.1 ? fill_direction_uniform : normalize(vec3(0.55, 0.35, 0.75));

    vec3 accum_color = vec3(0.0);
    float accum_alpha = 0.0;
    float accum_transmittance = 1.0;
    Ray cur_ray = ray;

    for (int step = 0; step < 8; ++step) {
        Hit hit;
        hit.distance = 3.402823e+38;
        if (!intersect_scene(cur_ray, hit))
            break;

        float max_coord = max(abs(hit.position.x), max(abs(hit.position.y), abs(hit.position.z)));
        float normal_offset = max(0.002, max_coord * 1e-4);
        vec3 offset_origin = hit.position + hit.normal * normal_offset;

        if (hit.tag < -1.5) {
            if (shadows_enabled) {
                // Multi-hit transmission loop: evaluates physical transmittance and Beer's law absorption
                vec3 direct_trans = vec3(1.0);
                Ray sh_ray;
                sh_ray.origin = offset_origin;
                sh_ray.direction = light_direction;

                for (int sh_step = 0; sh_step < 4; ++sh_step) {
                    Hit sh_hit;
                    sh_hit.distance = 3.402823e+38;
                    if (!traverse_scene(sh_ray, sh_hit, false))
                        break; // Reached open sunlight

                    float op = clamp(sh_hit.opacity, 0.0, 1.0);
                    if (op >= 0.95) {
                        // Opaque solid hit (e.g. solid red sphere) -> 100% occlusion
                        direct_trans = vec3(0.0);
                        break;
                    }

                    vec3 tri_albedo = shadings[sh_hit.tri_index].albedo.rgb;
                    // Beer-Lambert multi-layer absorption:
                    direct_trans *= (1.0 - op) * tri_albedo;
                    if (max(direct_trans.r, max(direct_trans.g, direct_trans.b)) < 0.02) {
                        direct_trans = vec3(0.0);
                        break;
                    }

                    float push_dist = max(0.005, sh_hit.distance * 1e-4);
                    sh_ray.origin = sh_hit.position + sh_ray.direction * push_dist;
                }

                float trans_lum = dot(direct_trans, vec3(0.299, 0.587, 0.114));
                float direct_occ = clamp(1.0 - trans_lum, 0.0, 1.0);
                float shadow_alpha = 0.40 * direct_occ;
                // Only tint direct shadow when there IS direct occlusion and transmitted colored light:
                vec3 direct_tint = (direct_occ > 0.01 && trans_lum > 0.01) ? (direct_trans * 0.75) : vec3(0.0);
                vec3 bounce_color = vec3(0.0);

                if (max_bounces > 1) {
                    Ray ao_ray_p;
                    ao_ray_p.origin = offset_origin;
                    ao_ray_p.direction = cosine_hemisphere(hit.normal, state);
                    Hit ao_hit_p;
                    ao_hit_p.distance = 3.402823e+38;
                    bool ao_occluded = intersect_scene(ao_ray_p, ao_hit_p);
                    // Crucial: Only consider hits on actual print objects (tag >= -1.5), not the plate itself!
                    if (ao_occluded && ao_hit_p.tag >= -1.5) {
                        float ao_falloff = 1.0 / (1.0 + 0.040 * ao_hit_p.distance);
                        float ao_opacity = clamp(ao_hit_p.opacity, 0.0, 1.0);
                        shadow_alpha += 0.38 * ao_falloff * ao_opacity;
                        // Diffuse indirect bounce (color bleed from lit surfaces):
                        vec3 hit_surf_albedo = shadings[ao_hit_p.tri_index].albedo.rgb;
                        float hit_ndl = max(0.0, dot(ao_hit_p.normal, light_direction));
                        float lit_factor = 0.25 + 0.75 * hit_ndl;
                        bounce_color = hit_surf_albedo * (lit_factor * ao_falloff * 0.45);
                    }
                }
                shadow_alpha = clamp(shadow_alpha, 0.0, 0.74);
                vec3 final_tint = max(direct_tint, bounce_color);
                accum_color += accum_transmittance * (final_tint * shadow_alpha);
                accum_alpha += accum_transmittance * shadow_alpha;
            }
            break;
        }

        Shading hit_shading = shadings[hit.tri_index];
        vec4 hit_albedo = hit_shading.albedo;
        float hit_layer_height = hit_shading.params.x;
        float hit_role = hit_shading.params.y;
        float hit_facet = hit_shading.params.z;

        float opacity = clamp(hit.opacity, 0.0, 1.0);
        if (opacity < 0.01) {
            cur_ray.origin = hit.position + cur_ray.direction * max(0.001, normal_offset * 0.5);
            continue;
        }

        vec3 shading_normal = hit.normal;
        float layer_profile = 1.0;
        float spec_profile = 1.0;
        float groove_lod = 0.0;

        if (hit.tag >= 0.0) {
            float h_len = length(hit.normal.xy);
            vec2 h_dir = h_len > 1e-4 ? (hit.normal.xy / h_len) : vec2(1.0, 0.0);
            float delta_angle = hit_shading.params.w;
            if (abs(delta_angle) > 1e-4) {
                float rot = (hit.seg_t - 0.5) * delta_angle;
                float cos_r = cos(rot);
                float sin_r = sin(rot);
                h_dir = vec2(h_dir.x * cos_r - h_dir.y * sin_r,
                             h_dir.x * sin_r + h_dir.y * cos_r);
            }
            float lh = (hit_layer_height > 0.01) ? hit_layer_height : 0.20;
            float layer_center = hit.tag - 0.5 * lh;
            float rel_z = clamp((hit.position.z - layer_center) / (0.5 * lh), -1.0, 1.0);

            if (hit_facet < 0.5) {
                // Deck / flat horizontal surfaces (infill, inner perimeters, upper-inner perimeter facet):
                // Gentle micro-facet blend so flat surfaces don't look like flat specular mirrors
                shading_normal = normalize(vec3(hit.normal.xy * 0.06, sign(hit.normal.z)));
            } else if (hit_facet < 1.5) {
                // Upper-outer rim / bevel of external perimeters:
                // Smooth transition from top deck (Z ≈ 0.80) to vertical wall (Z ≈ 0.25)
                float z_bevel = mix(0.25, 0.80, clamp(rel_z, 0.0, 1.0));
                shading_normal = normalize(vec3(h_dir * 0.60, z_bevel));
            } else if (layer_profile_mode > 0) {
                // Screen-space layer LOD to completely eliminate sub-pixel Moiré fringes
                float dist = camera_orthographic ? 1.0 : length(hit.position - camera_position);
                float pixel_size = camera_orthographic
                    ? (camera_orthographic_height / float(image_size.y))
                    : (dist * (2.0 * tan(camera_half_fov) / float(image_size.y)));
                float pixels_per_layer = lh / max(1e-5, pixel_size);
                groove_lod = smoothstep(3.5, 8.0, pixels_per_layer);

                float z_smooth = mix(0.0, rel_z * 0.25, groove_lod);
                shading_normal = normalize(vec3(h_dir, z_smooth));

                float groove = smoothstep(0.60, 0.98, abs(rel_z)) * groove_lod;
                layer_profile = mix(1.0, 0.88, groove);
                spec_profile = mix(1.0, 0.60, groove);
            } else {
                // Standard mode vertical walls: true horizontal macro normal
                // with subtle layer ridge so lighting is invariant under camera pitch
                float z_ridge = hit.normal.z * 0.12;
                shading_normal = normalize(vec3(h_dir, z_ridge));
            }
        }

        float ndl = dot(shading_normal, light_direction);
        Ray shadow_ray;
        Hit shadow_hit;
        shadow_hit.distance = 3.402823e+38;
        float shadow_vis = 1.0;
        vec3 shadow_light_tint = vec3(0.0);
        if (shadows_enabled && ndl > 0.0) {
            float lh = (hit_layer_height > 0.01) ? hit_layer_height : 0.20;
            float safe_bias = min(0.04, lh * 0.25);
            Ray sh_ray;
            sh_ray.origin = (hit.tag >= 0.0) ? (offset_origin + light_direction * safe_bias) : offset_origin;
            sh_ray.direction = light_direction;
            vec3 direct_trans = vec3(1.0);

            for (int sh_step = 0; sh_step < 3; ++sh_step) {
                Hit sh_hit;
                sh_hit.distance = 3.402823e+38;
                if (!traverse_scene(sh_ray, sh_hit, false))
                    break;

                float op = clamp(sh_hit.opacity, 0.0, 1.0);
                if (op >= 0.95) {
                    direct_trans = vec3(0.0);
                    break;
                }

                vec3 tri_albedo = shadings[sh_hit.tri_index].albedo.rgb;
                direct_trans *= (1.0 - op) * tri_albedo;
                if (max(direct_trans.r, max(direct_trans.g, direct_trans.b)) < 0.02) {
                    direct_trans = vec3(0.0);
                    break;
                }

                float push_dist = max(0.005, sh_hit.distance * 1e-4);
                sh_ray.origin = sh_hit.position + sh_ray.direction * push_dist;
            }

            float trans_lum = dot(direct_trans, vec3(0.299, 0.587, 0.114));
            shadow_vis = clamp(trans_lum, 0.0, 1.0);
            shadow_light_tint = direct_trans;
        } else if (ndl <= 0.0) {
            shadow_vis = 0.0;
        }

        float ao_vis = 1.0;
        vec3 indirect_bounce = vec3(0.0);
        if (max_bounces > 1) {
            Ray gi_ray;
            gi_ray.origin = offset_origin;
            gi_ray.direction = cosine_hemisphere(hit.normal, state);
            Hit gi_hit;
            gi_hit.distance = 3.402823e+38;
            if (intersect_scene(gi_ray, gi_hit)) {
                float gi_opacity = clamp(gi_hit.opacity, 0.0, 1.0);
                if (gi_opacity < 0.05) {
                    ao_vis = 1.0;
                } else if (hit.tag >= 0.0 && gi_hit.distance < 0.45) {
                    bool same_layer_neighbor = (abs(gi_hit.position.z - hit.position.z) < 0.25);
                    float base_ao = same_layer_neighbor ? 0.82 : 0.65;
                    ao_vis = mix(1.0, base_ao, gi_opacity);
                } else {
                    float base_ao = clamp(0.14 + gi_hit.distance * 0.035, 0.14, 0.85);
                    ao_vis = mix(1.0, base_ao, gi_opacity);
                }
                if (gi_hit.tag >= -1.5) {
                    float gi_ndl = max(0.0, dot(gi_hit.normal, light_direction));
                    float gi_lit = (!shadows_enabled || gi_ndl <= 0.0) ? 1.0 : max(0.25, gi_ndl);
                    vec4 gi_albedo = shadings[gi_hit.tri_index].albedo;
                    indirect_bounce = gi_albedo.rgb * ((0.04 + 0.30 * gi_ndl * gi_lit) * gi_opacity);
                }
            } else {
                vec3 sky_color = sky(gi_ray.direction);
                indirect_bounce = sky_color * 0.32;
                ao_vis = 1.0;
            }
        } else {
            ao_vis = 0.70 + 0.30 * max(0.0, hit.normal.z);
        }

        vec3 view_dir = -cur_ray.direction;
        float hemi = 0.5 + 0.5 * shading_normal.z;
        float amb = mix(0.16, 0.24, hemi) * ao_vis;
        float direct_key = max(0.0, ndl) * 0.45 * shadow_vis;
        float fill_ndl = max(0.0, dot(shading_normal, fill_direction));
        float cam_ndl = max(0.0, dot(shading_normal, view_dir));
        float direct_fill = (fill_ndl * 0.14 + cam_ndl * 0.10) * mix(0.40, 1.0, ao_vis);

        float diffuse_total = amb + direct_key + direct_fill;
        vec3 diffuse_color = hit_albedo.rgb * diffuse_total + hit_albedo.rgb * (shadow_light_tint * max(0.0, ndl) * 0.45);

        // Subsurface scattering: physically-based BSSRDF diffusion (Jiayin Cao / PBRT / Cycles)
        // Evaluated only on primary camera hits (step == 0) for print geometry (hit.tag >= -1.5)
        if (sss_mode > 0 && step == 0 && hit.tag >= -1.5 && opacity >= 0.90) {
            float sss_d = (sss_mode == 1) ? 0.60 : ((sss_mode == 2) ? 1.80 : 3.20);
            float sss_weight = (sss_mode == 1) ? 0.50 : ((sss_mode == 2) ? 0.75 : 0.90);

            // Construct orthonormal tangent frame around hit point
            vec3 u_tangent = abs(shading_normal.z) < 0.999
                ? normalize(cross(shading_normal, vec3(0.0, 0.0, 1.0)))
                : vec3(1.0, 0.0, 0.0);
            vec3 v_tangent = cross(shading_normal, u_tangent);

            // Sample random entry location on tangent disk using exponential diffusion profile
            float phi = 6.2831853 * random_float(state);
            float r = -sss_d * log(max(0.04, 1.0 - random_float(state) * 0.96));
            vec3 p_disk = hit.position + (u_tangent * cos(phi) + v_tangent * sin(phi)) * r;

            vec3 p_i = hit.position;
            vec3 n_i = shading_normal;
            vec3 c_i = hit_albedo.rgb;
            float shadow_vis_i = shadow_vis;

            if (!is_preview_canvas) {
                // In 3D Mesh (Prepare) tab: project tangent disk point onto geometry
                Ray probe_ray;
                probe_ray.origin = p_disk + hit.normal * (sss_d * 1.2);
                probe_ray.direction = -hit.normal;
                Hit probe_hit;
                probe_hit.distance = sss_d * 2.4;
                if (intersect_scene(probe_ray, probe_hit) && probe_hit.tag >= -1.5 && dot(probe_hit.normal, hit.normal) > 0.1) {
                    p_i = probe_hit.position;
                    n_i = probe_hit.normal;
                    c_i = shadings[probe_hit.tri_index].albedo.rgb;

                    float ndl_probe = max(0.0, dot(n_i, light_direction));
                    if (shadows_enabled && ndl_probe > 0.0 && probe_hit.tri_index != hit.tri_index) {
                        Ray shadow_ray_i;
                        float max_coord_i = max(abs(p_i.x), max(abs(p_i.y), abs(p_i.z)));
                        vec3 s_origin_i = p_i + n_i * max(0.002, max_coord_i * 1e-4);
                        shadow_ray_i.origin = s_origin_i;
                        shadow_ray_i.direction = light_direction;
                        Hit shadow_hit_i;
                        shadow_hit_i.distance = 3.402823e+38;
                        if (traverse_scene(shadow_ray_i, shadow_hit_i, true)) {
                            shadow_vis_i = 0.0;
                        } else {
                            shadow_vis_i = 1.0;
                        }
                    } else if (ndl_probe <= 0.0) {
                        shadow_vis_i = 0.0;
                    }
                }
            } else {
                // In G-code Preview tab: extrusion strands form a structured layer envelope.
                // Tangent-disk BSSRDF evaluates pigment diffusion directly without crevice probe jitter.
                p_i = p_disk;
            }

            // Direct lighting evaluated at entry point p_i
            float ndl_i = max(0.0, dot(n_i, light_direction));
            float direct_key_i = ndl_i * 0.45 * shadow_vis_i;
            float fill_ndl_i = max(0.0, dot(n_i, fill_direction));
            float cam_ndl_i = max(0.0, dot(n_i, view_dir));
            float direct_fill_i = (fill_ndl_i * 0.14 + cam_ndl_i * 0.10) * mix(0.40, 1.0, ao_vis);
            float hemi_i = 0.5 + 0.5 * n_i.z;
            float amb_i = mix(0.16, 0.24, hemi_i) * ao_vis;
            float diffuse_total_i = amb_i + direct_key_i + direct_fill_i;

            // Polymer pigment absorption: light traversing the plastic scatters into saturated body color
            float max_c = max(c_i.r, max(c_i.g, c_i.b));
            vec3 sss_tint = mix(c_i, (c_i * c_i) / max(0.08, max_c), 0.45);
            vec3 diffuse_subsurface = sss_tint * diffuse_total_i;

            diffuse_color = mix(diffuse_color, diffuse_subsurface, sss_weight);

            // Thin-wall backlight transmission:
            // Physically visible only when camera is oriented towards the backlight source (forward Mie scattering)
            float back_ndl = -ndl;
            float cam_backlight = dot(view_dir, -light_direction);
            if (back_ndl > 0.05 && cam_backlight > 0.0) {
                Ray trans_ray;
                trans_ray.origin = hit.position - hit.normal * normal_offset;
                trans_ray.direction = -hit.normal;
                Hit trans_hit;
                trans_hit.distance = (sss_mode == 3) ? (sss_d * 3.5) : (sss_d * 2.5);
                if (intersect_scene(trans_ray, trans_hit) && trans_hit.tag >= -1.5) {
                    float wall_thickness = trans_hit.distance;
                    vec3 n_back = -trans_hit.normal;
                    float back_light_ndl = max(0.0, dot(n_back, light_direction));
                    if (back_light_ndl > 0.0) {
                        Ray trans_shadow;
                        trans_shadow.origin = trans_hit.position + n_back * normal_offset;
                        trans_shadow.direction = light_direction;
                        Hit trans_sh_hit;
                        trans_sh_hit.distance = 3.402823e+38;
                        float back_vis = 1.0;
                        if (shadows_enabled && traverse_scene(trans_shadow, trans_sh_hit, true)) {
                            back_vis = 0.0;
                        }
                        float attenuation = exp(-wall_thickness / sss_d);
                        float forward_exp = (sss_mode == 3) ? 1.4 : 2.0;
                        float forward_scatter = pow(cam_backlight, forward_exp);
                        float trans_gain = (sss_mode == 3) ? 0.65 : 0.45;
                        float trans_light = back_light_ndl * trans_gain * back_vis * attenuation * (0.5 + 0.5 * forward_scatter) * sss_weight;
                        diffuse_color += sss_tint * trans_light;
                    }
                }
            }
        }

        vec3 refl_key = reflect(-light_direction, shading_normal);
        float spec_key = shadow_vis * pow(max(dot(view_dir, refl_key), 0.0), 32.0) * 0.06;
        vec3 refl_fill = reflect(-fill_direction, shading_normal);
        float spec_fill = ao_vis * pow(max(dot(view_dir, refl_fill), 0.0), 24.0) * 0.03;
        float spec_layer = 1.0;
        float specular = (spec_key + spec_fill) * spec_layer * spec_profile;
        vec3 spec_tint = (hit.tag >= 0.0) ? mix(hit_albedo.rgb, vec3(1.0), 0.25) : vec3(1.0);
        vec3 specular_color = spec_tint * specular;

        vec3 radiance = diffuse_color * layer_profile + hit_albedo.rgb * (indirect_bounce * layer_profile) + specular_color;

        accum_color += accum_transmittance * (radiance * opacity);
        accum_alpha += accum_transmittance * opacity;
        accum_transmittance *= (1.0 - opacity);

        if (accum_transmittance < 0.005)
            break;

        cur_ray.origin = hit.position + cur_ray.direction * max(0.001, normal_offset * 0.5);
    }

    return vec4(accum_color, accum_alpha);
}

vec3 apply_tone(vec3 color)
{
    return clamp(color, vec3(0.0), vec3(1.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, image_size)))
        return;

    g_has_clipping = dot(clipping_plane.xyz, clipping_plane.xyz) > 0.5;
    g_has_move_filter = (move_min >= 0 || move_max >= 0);
    g_has_z_filter = (z_min > -1e5 || z_max < 1e5);

    uint pixel_seed = uint(pixel.y * image_size.x + pixel.x + 1) * 0x9e3779b9u;
    vec4 sum = sample_start == 0 ? vec4(0.0) : imageLoad(accumulation_image, pixel);
    float aspect = float(image_size.x) / float(image_size.y);

    for (int sample_index = 0; sample_index < sample_count; ++sample_index) {
        int s_idx = sample_start + sample_index;
        uint state = pixel_seed ^ (uint(s_idx) * 0x85ebca6bu);
        // Stochastic low-discrepancy R2 jittering: breaks geometric Moiré patterns on all frames
        vec2 r2 = fract(vec2(float(s_idx) * 0.754877666, float(s_idx) * 0.569840291));
        vec2 jitter = fract(vec2(random_float(state), random_float(state)) + r2);
        vec2 normalized = (vec2(pixel) + jitter) / vec2(image_size) * 2.0 - 1.0;
        normalized.y = -normalized.y;
        Ray ray;
        if (camera_orthographic) {
            float half_height = camera_orthographic_height * 0.5;
            ray.origin = camera_position + camera_right * (normalized.x * aspect * half_height) + camera_up * (normalized.y * half_height);
            ray.direction = camera_forward;
        } else {
            ray.origin = camera_position;
            ray.direction = normalize(camera_forward + camera_right * (normalized.x * tan(camera_half_fov) * aspect) +
                                      camera_up * (normalized.y * tan(camera_half_fov)));
        }
        vec4 sample_val = trace_path(ray, state);
        if (!any(isnan(sample_val)) && !any(isinf(sample_val))) {
            sum += sample_val;
        } else if (s_idx > 0) {
            sum += (sum / float(s_idx));
        }
    }

    int total_samples = sample_start + sample_count;
    imageStore(accumulation_image, pixel, sum);
    vec4 avg = sum / float(total_samples);
    float out_alpha = clamp(avg.a, 0.0, 1.0);
    vec3 unpremul = (out_alpha > 1e-4 && !any(isnan(avg.rgb)) && !any(isinf(avg.rgb)))
        ? (avg.rgb / out_alpha)
        : vec3(0.0);
    imageStore(display_image, pixel, vec4(apply_tone(unpremul), out_alpha));
}
