node_modules/
# Build output of the Nitro package (tsc); the app's lib/ is source.
packages/*/lib/
.expo/
# expo prebuild regenerates the native projects on each run; treat them as build output.
apps/*/ios/
apps/*/android/
# Written by the react-native-bootsplash config plugin during prebuild.
apps/*/assets/bootsplash/
ios/build/
android/build/
*.tsbuildinfo
# Built by scripts/build_ios_core.sh or downloaded from CI; never committed.
packages/orca-core/ios/OrcaCore.xcframework/

# Generated by scripts/i18n.mjs (pnpm i18n); catalogs.ts stays so typecheck works without them.
apps/orca/i18n/*.json
