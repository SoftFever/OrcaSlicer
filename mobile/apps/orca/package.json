{
  "name": "orca-app",
  "version": "0.0.1",
  "private": true,
  "description": "OrcaSlicer mobile app",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm i18n && pnpm help-images && expo start",
    "ios": "pnpm i18n && pnpm help-images && expo run:ios",
    "android": "pnpm i18n && pnpm help-images && expo run:android",
    "prebuild": "pnpm i18n && pnpm help-images && expo prebuild",
    "typecheck": "pnpm routes && tsc --noEmit",
    "routes": "expo customize tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n": "node ../../scripts/i18n.mjs",
    "help-images": "node ../../scripts/help-images.mjs",
    "help-docs": "node --experimental-strip-types --no-warnings ../../scripts/help-docs.mjs",
    "lint:tokens": "! grep -rnE 'text-\\\\[[0-9]+px\\\\]|#[0-9a-fA-F]{6}' app ui | grep -v 'ui/theme/' | grep -v 'filamentColor' | grep -v '\\.test\\.'"
  },
  "dependencies": {
    "@expo/ui": "^57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "^5.2.1",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~57.0.21",
    "expo-background-task": "^57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-network": "^57.0.2",
    "expo-notifications": "^57.0.18",
    "expo-router": "~57.0.20",
    "expo-screen-orientation": "^57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "^57.0.17",
    "expo-widgets": "^57.0.19",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bootsplash": "^7.3.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-orca-core": "workspace:*",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "^14.0.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.15",
    "@vitest/expect": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
